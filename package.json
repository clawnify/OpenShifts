{
  "name": "open-shifts",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler d1 execute open-shifts-db --local --file=schema.sql && concurrently -n ui,api -c cyan,green \"vite\" \"wrangler dev --port 8793\"",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "previews:build": "node scripts/build-previews.mjs build",
    "previews:import": "node scripts/build-previews.mjs import",
    "previews:check": "node scripts/build-previews.mjs check",
    "previews:export": "node scripts/build-previews.mjs export"
  },
  "dependencies": {
    "@clawnify/app": "^0.2.1",
    "@clawnify/db": "^0.4.1",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@tailwindcss/vite": "^4.2.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.6.0",
    "lucide-react": "^1.46.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.2.2",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260722.1",
    "@types/node": "^26.6.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.0.0",
    "typescript": "^7.0.2",
    "vite": "^6.0.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.0.0"
  }
}
